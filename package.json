{
  "name": "albasimia-ssg-core",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Reusable Astro foundations for static sites, content sources, GitOps, and deployment workflows.",
  "author": "albasimia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albasimia/albasimia-ssg-core.git"
  },
  "homepage": "https://github.com/albasimia/albasimia-ssg-core#readme",
  "bugs": {
    "url": "https://github.com/albasimia/albasimia-ssg-core/issues"
  },
  "keywords": [
    "astro",
    "static-site-generator",
    "gitops",
    "sitemap",
    "github-api",
    "cloudflare-pages"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "asc": "./bin/asc.mjs"
  },
  "exports": {
    "./site-meta": {
      "types": "./package-dist/features/site-meta/index.d.ts",
      "import": "./package-dist/features/site-meta/index.js"
    },
    "./sitemap": {
      "types": "./package-dist/features/sitemap/index.d.ts",
      "import": "./package-dist/features/sitemap/index.js"
    },
    "./content-source": {
      "types": "./package-dist/features/content-source/index.d.ts",
      "import": "./package-dist/features/content-source/index.js"
    },
    "./git-content": {
      "types": "./package-dist/features/git-content/index.d.ts",
      "import": "./package-dist/features/git-content/index.js"
    },
    "./deploy-status": {
      "types": "./package-dist/features/deploy-status/index.d.ts",
      "import": "./package-dist/features/deploy-status/index.js"
    },
    "./layouts/BaseLayout.astro": "./package-dist/layouts/BaseLayout.astro",
    "./styles/theme.css": "./package-dist/styles/theme.css",
    "./styles/global.css": "./package-dist/styles/global.css"
  },
  "files": [
    "package-dist/features/site-meta/",
    "package-dist/features/sitemap/",
    "package-dist/features/content-source/",
    "package-dist/features/git-content/",
    "package-dist/features/deploy-status/",
    "package-dist/internal/github-api/",
    "package-dist/layouts/",
    "package-dist/styles/",
    "bin/",
    "templates/deployment/cloudflare-pages/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:package": "npm run build:package:ts && npm run build:package:assets",
    "build:package:ts": "tsc -p tsconfig.lib.json",
    "build:package:assets": "node scripts/build-package-assets.mjs",
    "build:site": "astro build",
    "prebuild": "npm run build:package",
    "build": "npm run build:site",
    "preview": "astro preview",
    "check": "astro check",
    "pretest": "npm run build:package",
    "test": "vitest run",
    "prepare": "npm run build:package"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "astro": "^7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^26.1.1",
    "astro": "^7.1.1",
    "sass": "^1.101.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
